          {
            "type": "calculated",
            "name": "Status Exibição",
            "dataType": "string",
            "expression": "IF(Avaliacoes_Maturidade[StatusAvaliacao] = \"Validated\", \"Valid\", \"Incomplete\")",
            "summarizeBy": "none"
          }
        ],
        "partitions": [
          {
            "name": "Avaliacoes_Maturidade",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    // Fictional baseline SYN-MAT-BASE-001; no external data source.",
                "    Source = #table({\"AvaliacaoID\", \"Start time\", \"DataAvaliacao\", \"EmailRespondente\", \"Respondente\", \"Cliente\", \"AreaNegocio\", \"1_Total\", \"2_Total\", \"3_Total\", \"4_Total\", \"5_Total\", \"6_Total\", \"7_Total\", \"8_Total\", \"ScoreGeneral\", \"ScoreMaximo\", \"DataAvaliacaoDia\", \"ClienteArea\", \"StatusAvaliacao\"}, {{1, #datetime(2026,9,1,9,0,0), #datetime(2026,9,1,10,0,0), null, \"Synthetic assessor\", \"Synthetic Organization\", \"Unit A\", 2, 1.5, 2, 1, 2.5, 1, 2.25, 1.75, 1.75, 3, #datetime(2026,9,1,0,0,0), \"Synthetic Organization | Unit A\", \"Validated\"}}),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"AvaliacaoID\", Int64.Type}, {\"Start time\", type datetime}, {\"DataAvaliacao\", type datetime}, {\"EmailRespondente\", type text}, {\"Respondente\", type text}, {\"Cliente\", type text}, {\"AreaNegocio\", type text}, {\"1_Total\", type number}, {\"2_Total\", type number}, {\"3_Total\", type number}, {\"4_Total\", type number}, {\"5_Total\", type number}, {\"6_Total\", type number}, {\"7_Total\", type number}, {\"8_Total\", type number}, {\"ScoreGeneral\", type number}, {\"ScoreMaximo\", Int64.Type}, {\"DataAvaliacaoDia\", type datetime}, {\"ClienteArea\", type text}, {\"StatusAvaliacao\", type text}}),",
                "    SemStatus = Table.RemoveColumns(Typed, {\"StatusAvaliacao\"}),",
                "    Validacao = Table.AddColumn(SemStatus, \"StatusAvaliacao\", each let\n        Scores = {[1_Total], [2_Total], [3_Total], [4_Total], [5_Total], [6_Total], [7_Total], [8_Total]},\n        NumerosValidos = List.NonNullCount(Scores) = 8 and List.AllTrue(List.Transform(Scores, each if _ = null then false else _ >= 0 and _ <= 3)),\n        IdentificacaoValida = [Cliente] <> null and Text.Trim([Cliente]) <> \"\" and [AreaNegocio] <> null and Text.Trim([AreaNegocio]) <> \"\" and [AvaliacaoID] <> null and [DataAvaliacao] <> null,\n        GeralValido = if [ScoreGeneral] = null or not NumerosValidos then false else [ScoreGeneral] >= 0 and [ScoreGeneral] <= 3 and Number.Abs([ScoreGeneral] - List.Average(Scores)) < 0.000001\n        in if IdentificacaoValida and NumerosValidos and GeralValido then \"Validated\" else \"Incomplete\", type text)",
                "in",
                "    Validacao"
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navegação"
          },
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
