        "partitions": [
          {
            "name": "Score_Por_Pilar",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    Fonte = Avaliacoes_Maturidade,",
                "    #\"Colunas Não Dinâmicas\" = Table.Unpivot(Fonte, {\"1_Total\", \"2_Total\", \"3_Total\", \"4_Total\", \"5_Total\", \"6_Total\", \"7_Total\", \"8_Total\"}, \"Atributo\", \"Valor\"),",
                "    #\"Colunas Renomeadas\" = Table.RenameColumns(#\"Colunas Não Dinâmicas\",{{\"Atributo\", \"CodigoPilar\"}, {\"Valor\", \"ScorePilar\"}}),",
                "    #\"Coluna Condicional Adicionada\" = Table.AddColumn(#\"Colunas Renomeadas\", \"Pilar\", each if [CodigoPilar] = \"1_Total\" then \"Policy and Classification\" else if [CodigoPilar] = \"2_Total\" then \"Lineage and Metadata\" else if [CodigoPilar] = \"3_Total\" then \"Data Quality\" else if [CodigoPilar] = \"4_Total\" then \"Master and Reference Data\" else if [CodigoPilar] = \"5_Total\" then \"Security and Access\" else if [CodigoPilar] = \"6_Total\" then \"Data Lifecycle\" else if [CodigoPilar] = \"7_Total\" then \"Collection and Sharing\" else if [CodigoPilar] = \"8_Total\" then \"Audit and Compliance\" else \"Unidentified\"),",
                "    #\"Coluna Condicional Adicionada1\" = Table.AddColumn(#\"Coluna Condicional Adicionada\", \"OrdemPilar\", each if [CodigoPilar] = \"1_Total\" then 1 else if [CodigoPilar] = \"2_Total\" then 2 else if [CodigoPilar] = \"3_Total\" then 3 else if [CodigoPilar] = \"4_Total\" then 4 else if [CodigoPilar] = \"5_Total\" then 5 else if [CodigoPilar] = \"6_Total\" then 6 else if [CodigoPilar] = \"7_Total\" then 7 else if [CodigoPilar] = \"8_Total\" then 8 else 99)",
                "in",
                "    #\"Coluna Condicional Adicionada1\""
              ]
            }
          }
        ],
        "annotations": [
          {
            "name": "PBI_NavigationStepName",
            "value": "Navegação"
          },
          {
            "name": "PBI_ResultType",
            "value": "Table"
          }
        ]
