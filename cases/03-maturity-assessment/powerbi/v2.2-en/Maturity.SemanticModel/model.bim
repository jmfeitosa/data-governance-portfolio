      {
        "name": "_Medidas",
        "lineageTag": "12c9ee4a-512c-4956-83fb-c3e68dbe953c",
        "columns": [
          {
            "type": "calculatedTableColumn",
            "name": "Controle",
            "dataType": "int64",
            "isNameInferred": true,
            "isDataTypeInferred": true,
            "sourceColumn": "[Controle]",
            "formatString": "0",
            "lineageTag": "5ab7845a-2ac8-4bfa-a73c-59cffb5cd405",
            "summarizeBy": "sum",
            "annotations": [
              {
                "name": "SummarizationSetBy",
                "value": "Automatic"
              }
            ]
          }
        ],
        "partitions": [
          {
            "name": "_Medidas",
            "mode": "import",
            "source": {
              "type": "calculated",
              "expression": [
                "",
                "ROW(\"Controle\", 1)"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Total Avaliações Validateds",
            "expression": "[Total Avaliações Válidas]",
            "lineageTag": "70f33069-0339-41a3-b5f9-f4e37db1561f",
            "displayFolder": "00 Controle",
            "formatString": "0",
            "isHidden": true
          },
          {
            "name": "Score Geral Médio",
            "expression": [
              "",
              "CALCULATE(",
              "    AVERAGE(Avaliacoes_Maturidade[ScoreGeneral]),",
              "    Avaliacoes_Maturidade[StatusAvaliacao] = \"Validated\"",
              ")"
            ],
            "formatString": "0.00",
            "lineageTag": "4041f6b8-9b41-49b2-b6d7-ff4428cab5d6",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "03 Histórico"
          },
          {
            "name": "Score Máximo",
            "expression": "3",
            "formatString": "0.00",
            "lineageTag": "dabeb1fa-d0d3-4f9a-8fba-451b139a925b",
            "displayFolder": "01 Visão executiva"
          },
          {
            "name": "% Maturidade",
            "expression": "DIVIDE([Score Última Avaliação], [Score Máximo])",
            "formatString": "0.0%",
            "lineageTag": "6b79c1ae-d678-4639-b9f4-fd13a8aae5ef",
            "displayFolder": "01 Visão executiva"
          },
          {
            "name": "Score Médio por Pilar",
            "expression": [
              "",
              "CALCULATE(",
              "    AVERAGE(Score_Por_Pilar[ScorePilar]),",
              "    Score_Por_Pilar[StatusAvaliacao] = \"Validated\"",
              ")"
            ],
            "lineageTag": "ff6b6df3-0206-4612-8921-fcc3ed86a0b9",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "03 Histórico",
            "formatString": "0.00"
          },
          {
            "name": "Nível de Maturidade",
            "expression": "VAR S = [Score Última Avaliação]\nRETURN SWITCH(TRUE(), ISBLANK(S), \"No assessment\", S < 0 || S > 3, \"Invalid score\", S < 0.75, \"Initial\", S < 1.50, \"Developing\", S < 2.25, \"Defined\", S < 2.75, \"Managed\", \"Optimized\")",
            "lineageTag": "0feda92a-180e-4daf-a390-bf5896dac846",
            "displayFolder": "01 Visão executiva"
          },
          {
            "name": "Data Última Avaliação",
            "expression": "VAR IdAtual = [ID Última Avaliação]\nRETURN IF(NOT ISBLANK(IdAtual), CALCULATE(MAX(Avaliacoes_Maturidade[DataAvaliacao]), Avaliacoes_Maturidade[AvaliacaoID] = IdAtual))",
            "formatString": "yyyy-MM-dd HH:mm",
            "lineageTag": "dc7d49a7-eee8-49fd-b07c-217551877fb2",
            "displayFolder": "01 Visão executiva"
          },
          {
            "name": "Score Última Avaliação",
            "expression": "VAR IdAtual = [ID Última Avaliação]\nRETURN IF(NOT ISBLANK(IdAtual), CALCULATE(MAX(Avaliacoes_Maturidade[ScoreGeneral]), Avaliacoes_Maturidade[AvaliacaoID] = IdAtual))",
            "formatString": "0.00",
            "lineageTag": "8c9e0efc-d842-484a-a45f-9ed49661f2a3",
            "displayFolder": "01 Visão executiva"
          },
          {
            "name": "Título Cliente Selecionado",
            "expression": "SELECTEDVALUE(Avaliacoes_Maturidade[ClienteArea], \"Select an organization and unit\")",
            "lineageTag": "e6768a18-63a6-4be2-b48d-470792e1ddc2",
            "displayFolder": "01 Visão executiva"
          },
          {
            "name": "Score Radar",
            "expression": [
              "",
              "CALCULATE(",
              "    AVERAGE(Score_Por_Pilar[ScorePilar]),",
              "    Score_Por_Pilar[StatusAvaliacao] = \"Validated\"",
              ")"
            ],
            "lineageTag": "d198fcb8-5918-4847-9659-4001218b2f60",
            "annotations": [
              {
                "name": "PBI_FormatHint",
                "value": "{\"isGeneralNumber\":true}"
              }
            ],
            "displayFolder": "03 Histórico",
            "formatString": "0.00"
          },
          {
            "name": "Score Máximo Radar",
            "expression": "IF(NOT ISBLANK([ID Última Avaliação]), 3)",
            "formatString": "0.00",
            "lineageTag": "c16800c3-18bd-46da-a858-4b2a333dd7eb",
            "displayFolder": "02 Pilares"
          },
          {
            "name": "Score Radar Última Avaliação",
            "expression": "VAR IdAtual = [ID Última Avaliação]\nRETURN IF(NOT ISBLANK(IdAtual), CALCULATE(MAX(Score_Por_Pilar[ScorePilar]), Avaliacoes_Maturidade[AvaliacaoID] = IdAtual))",
            "formatString": "0.00",
            "lineageTag": "4a34f656-38b2-44f9-b742-73e73d9746d3",
            "displayFolder": "02 Pilares"
          },
          {
            "name": "ID Última Avaliação",
            "lineageTag": "bfac0c99-be71-417c-8e60-fdd8ce91e3d9",
            "expression": "VAR Linhas = FILTER(Avaliacoes_Maturidade, Avaliacoes_Maturidade[StatusAvaliacao] = \"Validated\")\nRETURN IF(HASONEVALUE(Avaliacoes_Maturidade[ClienteArea]),\n    MAXX(TOPN(1, Linhas, Avaliacoes_Maturidade[DataAvaliacao], DESC, Avaliacoes_Maturidade[AvaliacaoID], DESC), Avaliacoes_Maturidade[AvaliacaoID]))",
            "displayFolder": "00 Controle",
            "formatString": "0",
            "isHidden": true
          },
          {
            "name": "Score Atual Exibição",
            "lineageTag": "c35d0182-9620-4ee9-8af3-68986a179420",
            "expression": "IF(ISBLANK([Score Última Avaliação]), \"—\", FORMAT([Score Última Avaliação], \"0.00\", \"en-US\") & \" / 3.00\")",
            "displayFolder": "01 Visão executiva"
          },
          {
            "name": "ID Avaliação Anterior",
            "lineageTag": "863a64c5-e82f-47fb-8b1c-618cf6edf40f",
            "expression": "VAR IdAtual = [ID Última Avaliação]\nVAR Linhas = FILTER(Avaliacoes_Maturidade, Avaliacoes_Maturidade[StatusAvaliacao] = \"Validated\" && Avaliacoes_Maturidade[AvaliacaoID] <> IdAtual)\nRETURN IF(NOT ISBLANK(IdAtual), MAXX(TOPN(1, Linhas, Avaliacoes_Maturidade[DataAvaliacao], DESC, Avaliacoes_Maturidade[AvaliacaoID], DESC), Avaliacoes_Maturidade[AvaliacaoID]))",
            "displayFolder": "00 Controle",
            "formatString": "0",
            "isHidden": true
          },
          {
            "name": "Score Avaliação Anterior",
            "lineageTag": "e5751fe3-87a2-4202-841c-c87c5056cf30",
            "expression": "VAR IdAnterior = [ID Avaliação Anterior]\nRETURN IF(NOT ISBLANK(IdAnterior), CALCULATE(MAX(Avaliacoes_Maturidade[ScoreGeneral]), Avaliacoes_Maturidade[AvaliacaoID] = IdAnterior))",
            "displayFolder": "03 Histórico",
            "formatString": "0.00"
          },
          {
            "name": "Variação em Pontos",
            "lineageTag": "bad678f8-0f32-4a3a-99d7-f78d82cad26c",
            "expression": "IF(NOT ISBLANK([Score Avaliação Anterior]), [Score Última Avaliação] - [Score Avaliação Anterior])",
            "displayFolder": "03 Histórico",
            "formatString": "+0.00;-0.00;0.00"
          },
          {
            "name": "Variação Exibição",
            "lineageTag": "2dd899a8-131f-4617-9703-dc80c3b0fd95",
            "expression": "IF(ISBLANK([Variação em Pontos]), \"No previous\", FORMAT([Variação em Pontos], \"+0.00;-0.00;0.00\", \"en-US\") & \" point(s)\")",
            "displayFolder": "01 Visão executiva"
          },
          {
            "name": "Total Avaliações Válidas",
            "lineageTag": "7bbebe1a-bd44-496f-b801-0a174ce0caed",
            "expression": "COALESCE(CALCULATE(DISTINCTCOUNT(Avaliacoes_Maturidade[AvaliacaoID]), Avaliacoes_Maturidade[StatusAvaliacao] = \"Validated\"), 0)",
            "displayFolder": "04 Qualidade",
            "formatString": "0"
          },
          {
            "name": "Avaliações Incompletas",
            "lineageTag": "5614634b-b6ef-416d-b326-ef4bb5613df1",
            "expression": "COALESCE(COUNTROWS(FILTER(Avaliacoes_Maturidade, Avaliacoes_Maturidade[StatusAvaliacao] <> \"Validated\")), 0)",
            "displayFolder": "04 Qualidade",
            "formatString": "0"
          },
          {
            "name": "Total Avaliações",
            "lineageTag": "2917b928-b24a-45e8-9646-2944108e0525",
            "expression": "COALESCE(COUNTROWS(Avaliacoes_Maturidade), 0)",
            "displayFolder": "04 Qualidade",
            "formatString": "0"
          },
          {
            "name": "IDs Duplicados",
            "lineageTag": "80f8a570-9537-489a-a545-9d6d5eeda27b",
            "expression": "COALESCE(COUNTROWS(Avaliacoes_Maturidade) - DISTINCTCOUNT(Avaliacoes_Maturidade[AvaliacaoID]), 0)",
            "displayFolder": "04 Qualidade",
            "formatString": "0"
          },
          {
            "name": "Scores Fora da Faixa",
            "lineageTag": "f544368d-7442-4f45-b2e0-a1af2b54f5b2",
            "expression": "COALESCE(COUNTROWS(FILTER(Score_Por_Pilar, NOT ISBLANK(Score_Por_Pilar[ScorePilar]) && (Score_Por_Pilar[ScorePilar] < 0 || Score_Por_Pilar[ScorePilar] > 3))), 0)",
            "displayFolder": "04 Qualidade",
            "formatString": "0"
          },
          {
            "name": "Avaliações com Pilares Ausentes",
            "lineageTag": "2d750e6c-e2a7-41bd-b54d-dfb390f0dc33",
            "expression": "COALESCE(COUNTROWS(FILTER(VALUES(Avaliacoes_Maturidade[AvaliacaoID]), CALCULATE(COUNTROWS(Score_Por_Pilar)) <> 8)), 0)",
            "displayFolder": "04 Qualidade",
            "formatString": "0"
          },
          {
            "name": "Divergências de Score",
            "lineageTag": "88b29c77-13cc-4629-9005-ba96f2dc72a0",
            "expression": "COALESCE(COUNTROWS(FILTER(Avaliacoes_Maturidade, NOT ISBLANK(Avaliacoes_Maturidade[ScoreGeneral]) && ABS(Avaliacoes_Maturidade[ScoreGeneral] - CALCULATE(AVERAGE(Score_Por_Pilar[ScorePilar]))) > 0.000001)), 0)",
            "displayFolder": "04 Qualidade",
            "formatString": "0"
          },
          {
            "name": "Pilar Menor Score",
            "lineageTag": "c6164f3c-c026-4000-a34e-3c800acba8a8",
            "expression": "VAR IdAtual = [ID Última Avaliação]\nVAR Linhas = FILTER(Score_Por_Pilar, Score_Por_Pilar[AvaliacaoID] = IdAtual)\nRETURN IF(NOT ISBLANK(IdAtual), CONCATENATEX(TOPN(1, Linhas, Score_Por_Pilar[ScorePilar], ASC, Score_Por_Pilar[OrdemPilar], ASC), Score_Por_Pilar[Pilar], \"\"), \"—\")",
            "displayFolder": "01 Visão executiva"
          },
          {
            "name": "Menor Score por Pilar",
            "lineageTag": "10c6e953-ae32-4958-ad55-5244f6c76f92",
            "expression": "VAR IdAtual = [ID Última Avaliação]\nRETURN IF(NOT ISBLANK(IdAtual), MINX(FILTER(Score_Por_Pilar, Score_Por_Pilar[AvaliacaoID] = IdAtual), Score_Por_Pilar[ScorePilar]))",
            "displayFolder": "01 Visão executiva",
            "formatString": "0.00"
          }
        ],
        "annotations": [
          {
            "name": "PBI_Id",
            "value": "41090f0b348b4851a1295f1cf94cd638"
          }
        ]
      },
